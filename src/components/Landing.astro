---
import { Image } from "astro:assets";
import GridPattern from "./ui/GridPattern.astro";

import linxtLogo from "../assets/linxt.svg";
import pegadaianLogo from "../assets/featured-clients/pegadaian.svg";
import geonetLogo from "../assets/featured-clients/geonet.png";
import sanLogo from "../assets/featured-clients/san.svg";
import { Cog, Handshake, Users } from "lucide-astro";
---

<section class="flex justify-center w-full pt-4 overflow-x-hidden">
    <GridPattern />
    <div class="flex flex-col w-full max-w-screen-xl py-32 px-16 gap-32">
        <div class="flex flex-col gap-6 items-center justify-center text-center">
            <Image class="mb-2" src={linxtLogo} alt="Linxt Studio" width="160" height="40" />
            <h2 class="text-2xl leading-8 sm:text-4xl sm:leading-12 lg:text-7xl lg:leading-24 font-semibold text-neutral-900 ">Redefining the Art of <br><b class="font-extrabold">Digital Problem-Solving</b></h2>
            <p class="text-neutral-700 max-w-120">Linxt lets you elevate your digital impact with cutting-edge tech and superior user experience</p>
            <a href="#" class="flex items-center justify-center text-sm font-medium px-6 py-3 border rounded-full border-primary-500 text-neutral-900 hover:bg-primary-500 hover:text-white transition-colors">
                Our Works
            </a>
        </div>
        <div class="flex flex-col gap-8">
            <h3 class="text-lg font-bold text-neutral-900 text-center md:text-left">Featured Clients</h3>
            <div class="flex justify-center md:justify-start gap-x-16 gap-y-4 items-center flex-col md:flex-row">
                <Image class="grayscale hover:grayscale-0 opacity-75 hover:opacity-100 transition-[filter,opacity]" src={pegadaianLogo} alt="Pegadaian" width="128" height="128" />
                <Image class="grayscale hover:grayscale-0 opacity-75 hover:opacity-100 transition-[filter,opacity]" src={geonetLogo} alt="Geonet" width="160" height="160" />
                <Image class="grayscale hover:grayscale-0 opacity-75 hover:opacity-100 transition-[filter,opacity]" src={sanLogo} alt="Social Arisan Nyok!" width="80" height="80" />
            </div>
        </div>
    </div>
</section>
<section class="flex justify-center w-full pt-4 bg-neutral-900">
    <div class="flex flex-col w-full max-w-screen-xl py-32 px-16 gap-32">
        <div class="flex flex-col gap-16">
            <div class="flex flex-col gap-6 max-w-150">
                <h2 class="text-3xl leading-12 font-semibold text-neutral-50 ">From Concept to Creation: Crafting Custom Solutions</h2>
                <p class="text-neutral-100">At Linxt, we are passionate about solving problems and delivering results, and we are committed to delivering the very best in digital solutions.</p>
            </div>
            <div class="flex flex-col md:flex-row gap-8">
                <div class="flex flex-col gap-2 p-8 rounded-xl bg-white w-full max-w-80">
                    <Users />
                    <p class="text-lg font-bold text-neutral-900">Collaborative Approach</p>
                    <p class="text-sm text-neutral-700">Continuous interaction between stakeholders</p>
                </div>
                <div class="flex flex-col gap-2 p-8 rounded-xl bg-white w-full max-w-80">
                    <Cog />
                    <p class="text-lg font-bold text-neutral-900">User-Driven Development</p>
                    <p class="text-sm text-neutral-700">Create user-centered solutions that meet the needs of the target audience</p>
                </div>
                <div class="flex flex-col gap-2 p-8 rounded-xl bg-white w-full max-w-80">
                    <Handshake />
                    <p class="text-lg font-bold text-neutral-900">Honesty as a Foundation</p>
                    <p class="text-sm text-neutral-700">We always operate with transparency, integrity and a strong sense of ethics</p>
                </div>
            </div>
        </div>
    </div>
</section>